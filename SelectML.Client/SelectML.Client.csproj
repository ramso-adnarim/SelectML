<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Authors>Ramso Adnarim</Authors>
    <Company>Ramso Adnarim</Company>
    <Product>SelectML</Product>
    <Description>Monitoramento e integração de arquivos</Description>
    <ApplicationIcon>Resources\SelectML-logo-short-light.ico</ApplicationIcon>
    <Version>1.2.8</Version>
    <AssemblyVersion>1.2.8.0</AssemblyVersion>
    <FileVersion>1.2.8.0</FileVersion>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SelectML.Core\SelectML.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\**\*.ico" />
    <Resource Include="Resources\**\*.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <PackageReference Include="Serilog" Version="4.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
    <PackageReference Include="System.IO.Ports" Version="10.0.2" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="EnsureWindowsSerialPortDll" AfterTargets="Build;Publish">
    <Copy SourceFiles="$(PkgSystem_IO_Ports)\runtimes\win\lib\net8.0\System.IO.Ports.dll"
          DestinationFolder="$(TargetDir)"
          Condition="Exists('$(PkgSystem_IO_Ports)\runtimes\win\lib\net8.0\System.IO.Ports.dll')"
          OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="$(PkgSystem_IO_Ports)\runtimes\win\lib\net8.0\System.IO.Ports.dll"
          DestinationFolder="$(PublishDir)"
          Condition="'$(PublishDir)' != '' and Exists('$(PkgSystem_IO_Ports)\runtimes\win\lib\net8.0\System.IO.Ports.dll')"
          OverwriteReadOnlyFiles="true" />
  </Target>

</Project>
