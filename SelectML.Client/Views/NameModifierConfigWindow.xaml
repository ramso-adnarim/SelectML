<Window x:Class="SelectML.Client.Views.NameModifierConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuração de Nomes" Height="330" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource ModernWindowStyle}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Formato do Nome da Característica:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,5" Grid.Row="0"/>
        
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Border x:Name="TextBoxBorder" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Brush.Input.Background}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Base}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasBrokenTags}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Error}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <!-- Syntax Highlight Layer -->
                    <TextBlock x:Name="SyntaxHighlightTextBlock" Margin="9,7,9,7" 
                               FontFamily="Consolas" FontSize="14"
                               Foreground="{DynamicResource Brush.Text.Primary}" 
                               IsHitTestVisible="False" VerticalAlignment="Center"/>
                    
                    <!-- Input Layer -->
                    <TextBox x:Name="FormatTextBox" Text="{Binding CustomNameModifierFormat, UpdateSourceTrigger=PropertyChanged}" 
                             Height="30" VerticalContentAlignment="Center" Background="Transparent" 
                             FontFamily="Consolas" FontSize="14"
                             Foreground="Transparent" CaretBrush="{DynamicResource Brush.Text.Primary}"
                             BorderThickness="0"
                             TextChanged="FormatTextBox_TextChanged"/>
                </Grid>
            </Border>
        </Grid>
        
        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,0,0,15">
            <Button Content="Nominal" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanInsertNominal}" Command="{Binding InsertTokenCommand}" CommandParameter="Nominal" Margin="0,0,10,0"/>
            <Button Content="Tolerância" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanInsertTolerance}" Command="{Binding InsertTokenCommand}" CommandParameter="Tolerancia"/>
        </StackPanel>

        <Border Grid.Row="3" Background="{DynamicResource Brush.Surface.Card}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="6" Padding="10"
                IsEnabled="{Binding CanConfigureTags}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Casas decimais:" Grid.Column="0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                <TextBox Text="{Binding Decimals, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Width="30" Margin="10,0,20,0" HorizontalAlignment="Left" MaxLength="1"/>

                <StackPanel Orientation="Horizontal" Grid.Column="2" HorizontalAlignment="Right">
                    <RadioButton Content="Arredondar" IsChecked="{Binding IsRoundingMode}" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,15,0" VerticalAlignment="Center"/>
                    <RadioButton Content="Truncar" IsChecked="{Binding IsTruncateMode}" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" VerticalAlignment="Center" Margin="0,15,0,0">
            <TextBlock Text="Exemplo Gerado:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}"/>
            <TextBlock Text="{Binding PreviewText}" Foreground="{DynamicResource Brush.Text.Secondary}" FontStyle="Italic" FontSize="14" Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="5" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancelar" Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}" Margin="0,0,10,0"/>
            <Button Content="Salvar" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanSave}" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>
