<Window x:Class="SelectML.Client.Views.ConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmação" SizeToContent="Height" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Brush.Background.Base}" Foreground="{DynamicResource Brush.Text.Primary}"
        Style="{StaticResource ModernWindowStyle}">
    <Grid Margin="20,15,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Existem características não reconhecidas na corrida. Como deseja prosseguir?"
                   TextWrapping="Wrap" LineHeight="20" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,5,0,15"/>

        <CheckBox x:Name="DontAskCheckBox" Grid.Row="1" Content="Não perguntar novamente" Margin="0,0,0,20" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Enviar todas" Width="95" Height="30" Click="SendAll_Click" Margin="0,0,10,0" Style="{DynamicResource PrimaryButton}"/>
            <Button Content="Apenas reconhecidas" Width="160" Height="30" Click="SendRecognized_Click" Margin="0,0,10,0" Style="{DynamicResource GhostButton}" FontWeight="Bold" Cursor="Hand"/>
            <Button Content="Cancelar" Width="85" Height="30" Click="Cancel_Click" IsCancel="True" Style="{DynamicResource DangerButton}"/>
        </StackPanel>
    </Grid>
</Window>
