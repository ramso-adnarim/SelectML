<Window x:Class="SelectML.Client.Views.SerialConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SelectML.Client.Converters"
        Title="Conexão serial" Height="395" Width="340"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        Style="{StaticResource ModernWindowStyle}">
    
    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Modern Toggle Switch Style -->
        <Style x:Key="ModernToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Track"
                                    Width="38" Height="20"
                                    CornerRadius="10"
                                    Background="{DynamicResource Brush.Text.Inactive}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource Brush.Border.Base}"/>
                            <Ellipse x:Name="Knob"
                                     Width="14" Height="14"
                                     Fill="#FFFFFF"
                                     HorizontalAlignment="Left"
                                     Margin="4,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.3" Color="Black"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Action.Primary}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Action.Primary}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="Knob" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Configuração do Dispositivo" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="{DynamicResource TextBrush}"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <!-- Port Selection -->
            <TextBlock Text="Porta COM:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource TextBrush}"/>
            <ComboBox ItemsSource="{Binding AvailablePorts}" 
                      SelectedItem="{Binding SelectedPort}" 
                      IsEnabled="{Binding IsDisconnected}"
                      Height="24" Margin="0,0,0,15"/>

            <!-- Strategy Selection -->
            <TextBlock Text="Dispositivo:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource TextBrush}"/>
            <ComboBox ItemsSource="{Binding AvailableStrategies}" 
                      SelectedItem="{Binding SelectedStrategy}" 
                      IsEnabled="{Binding IsDisconnected}"
                      Height="24" Margin="0,0,0,10">
                 <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Custom Config Button & Default Feature Name -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <StackPanel Orientation="Vertical" Margin="0,0,10,0" Width="180">
                    <TextBlock Text="Nome padrão de característica:" FontSize="11" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding DefaultFeatureName}"
                             IsEnabled="{Binding IsDefaultFeatureNameEnabled}"
                             Height="26" 
                             VerticalContentAlignment="Center" Padding="8,0,3,0"/>
                </StackPanel>

                <Button Content="Editar JSON" 
                        Command="{Binding OpenJsonConfigCommand}" 
                        Padding="5,0" VerticalAlignment="Bottom" Height="26" VerticalContentAlignment="Center"
                        IsEnabled="{Binding IsDisconnected}"
                        Visibility="{Binding IsCustomStrategySelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Style="{DynamicResource GhostButton}"/>
            </StackPanel>

            <!-- Toggle Enfileirar Dados de Entrada -->
            <Border Margin="0,5,0,0" Padding="10,8" 
                    Background="{DynamicResource Brush.Surface.Card}" 
                    BorderBrush="{DynamicResource Brush.Border.Base}" 
                    BorderThickness="1" 
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="Enfileirar dados de entrada" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock FontSize="10" Foreground="{DynamicResource Brush.Text.Secondary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Adiciona medições à lista do arquivo"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EnqueueSerialInput}" Value="True">
                                            <Setter Property="Text" Value="Bufferiza dados para envio posterior"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <ToggleButton Grid.Column="1" 
                                  IsChecked="{Binding EnqueueSerialInput, Mode=TwoWay}"
                                  IsEnabled="{Binding IsDisconnected}"
                                  Style="{StaticResource ModernToggleSwitch}"
                                  VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Desconectar" Command="{Binding DisconnectCommand}" 
                    Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="0,0,10,0" Style="{DynamicResource DangerButton}"/>
            
            <Button Content="Conectar" Command="{Binding ConnectCommand}" 
                     Visibility="{Binding IsDisconnected, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="0,0,10,0" Style="{DynamicResource PrimaryButton}"/>
            
            <Button Content="Fechar" IsCancel="True" Click="Close_Click" Style="{DynamicResource GhostButton}"/>
        </StackPanel>
    </Grid>
</Window>
